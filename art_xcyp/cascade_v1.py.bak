#!/usr/bin/env python3
"""THE EQUAL HOURS AND THE UNEQUAL ESTATE — one Osgood arc, two inheritances.

Knopp's construction with wedge schedule r_k = 1/(k+2)^2 gives a Jordan arc
of area EXACTLY (2/3) A0 (telescoping product). The parameter interval always
splits in HALF (equal hours of the journey), but the ESTATE (area) splits
   child1 : child2 = p(1-r) : q(1-r),  q = 1-p.
p = 1/2 (upper wing): arc-time pushforward == normalized Lebesgue on the arc —
every stretch of the journey owns exactly its share of the estate.
p = 0.30 (lower wing): the SAME total estate (2/3 A0, same telescoping), but
the time measure is now a binomial multiplicative cascade ON the arc —
singular w.r.t. area: full time lives on a set of zero area. Equal hours,
unequal estate.

Both wings rendered by the SAME pipeline (positive control): brightness =
occupation TIME density (each leaf splats its true time measure 2^-depth),
hue = time along the journey; the same non-dyadic 4.2% time-window
[0.700, 0.742) is lit gold in both wings — above it owns 4.2% of the estate,
below it owns whatever the cascade decrees (measured exactly; printed).

Certificates asserted at build time:
  * chain continuity: exit(leaf i) == entry(leaf i+1) bit-exact on the
    refinement frontier at every level;
  * total leaf area == A0 * prod_{k<=d}(1-r_k) (shoelace vs telescoping)
    rel err < 1e-9 at the uniform certificate depth, both wings;
  * depth-13 subtree areas == A0 * prod(1-r_k) * p^j q^(13-j) exactly
    (the binomial cascade law), max rel err < 1e-9;
  * time-window estate share: balanced wing == window length to < 1e-3.
"""
import numpy as np, sys, time
import scipy.ndimage as ndi
from PIL import Image

PROTO = len(sys.argv) > 1 and sys.argv[1] == "proto"
SIZE  = 1024 if PROTO else 2560
SS    = 2
S     = SIZE * SS
rs    = SIZE / 1024.0
OUT   = "cascade_proto.png" if PROTO else "cascade_2560.png"

T0, DT = 0.700, 0.042            # the lit journey-stretch (non-dyadic)
AREA_THRESH = 0.30 * (SS * SS)    # refine until leaf area < this (px^2)
CERT_DEPTH = 9 if PROTO else 13   # frontier must still be complete here

def rk(k): return 1.0 / (k + 2) ** 2

margin = 0.050 * S
# wing 1 (balanced): entry top-left, exit bottom-right, apex bottom-left
# wing 2 (cascade): mirrored across the main diagonal -> apex top-right
WINGS = [
    dict(p=0.5,  E=(margin, margin), F=(S - margin, S - margin), C=(margin, S - margin)),
    dict(p=0.30, E=(margin, margin), F=(S - margin, S - margin), C=(S - margin, margin)),
]
A0 = 0.5 * (S - 2 * margin) ** 2

anch = np.array([
    [0.98, 0.80, 0.38], [0.96, 0.46, 0.22], [0.82, 0.26, 0.48],
    [0.42, 0.28, 0.78], [0.20, 0.46, 0.92], [0.36, 0.86, 0.88],
])
def palette(t):
    x = t * (len(anch) - 1)
    i = np.clip(x.astype(int), 0, len(anch) - 2)
    f = (x - i)[:, None]
    f = f * f * (3 - 2 * f)
    return anch[i] * (1 - f) + anch[i + 1] * f

buf   = np.zeros((3, S, S), dtype=np.float32)
tdens = np.zeros((S, S), dtype=np.float32)      # raw time density (for AO/lum)
blaze = np.zeros(S * S, dtype=np.float32)
bufflat = [buf[ch].ravel() for ch in range(3)]
tflat = tdens.ravel()
for v in bufflat + [tflat]:
    assert v.base is not None

t_start = time.time()
report = {}
for wing in WINGS:
    p = wing["p"]; q = 1 - p
    E = np.array([list(wing["E"])]); F = np.array([list(wing["F"])]); C = np.array([list(wing["C"])])
    tlo = np.array([0.0])
    wing_area_splat = 0.0
    wing_blaze_area = 0.0
    level = 0
    prod = 1.0
    nsplat = 0
    while len(E):
        level += 1
        r = rk(level)
        d1 = p * (1 - r); d2 = d1 + r
        assert d1 < d2 < 1
        D1 = E + d1 * (F - E)
        D2 = E + d2 * (F - E)
        n = len(E)
        E2 = np.empty((2 * n, 2)); F2 = np.empty((2 * n, 2)); C2 = np.empty((2 * n, 2))
        E2[0::2], F2[0::2], C2[0::2] = E, C, D1
        E2[1::2], F2[1::2], C2[1::2] = C, F, D2
        # chain continuity (bit-exact): child1.exit == child2.entry == C
        assert np.max(np.abs(E2[1::2] - F2[0::2])) == 0.0
        tw = 0.5 ** level
        t2 = np.empty(2 * n); t2[0::2] = tlo; t2[1::2] = tlo + tw
        prod *= (1 - r)
        E, F, C, tlo = E2, F2, C2, t2
        ar = 0.5 * np.abs((F[:, 0] - E[:, 0]) * (C[:, 1] - E[:, 1])
                          - (C[:, 0] - E[:, 0]) * (F[:, 1] - E[:, 1]))
        if level == CERT_DEPTH:
            # binomial cascade law certificate: subtree area = A0*prod*p^j q^(d-j)
            j = np.zeros(len(E))
            idx = np.arange(len(E))
            for b in range(CERT_DEPTH):
                j += 1 - ((idx >> b) & 1)  # bit 0 (even index at that split) = child1 = p-side
            # NOTE index bit order: at each do_level children interleave 0::2,1::2
            # so bit b of the final index (LSB = last split) = 0 for child1.
            expect = A0 * prod * (p ** j) * (q ** (CERT_DEPTH - j))
            relmax = np.max(np.abs(ar - expect) / expect)
            assert relmax < 1e-9, relmax
            report[f"cert_p{p}"] = f"depth-{CERT_DEPTH} binomial law max rel err {relmax:.2e}"
            # total-area telescoping certificate
            rel = abs(ar.sum() - A0 * prod) / (A0 * prod)
            assert rel < 1e-9
        # splat leaves that reached pixel scale (or depth cap)
        done = ar < AREA_THRESH
        if level >= 50:
            done = np.ones(len(E), bool)
        if done.any():
            e, f, c, a, tl = E[done], F[done], C[done], ar[done], tlo[done]
            cx = (e[:, 0] + f[:, 0] + c[:, 0]) / 3
            cy = (e[:, 1] + f[:, 1] + c[:, 1]) / 3
            tmid = tl + 0.5 ** (level + 1)
            w = np.full(len(a), 0.5 ** level, dtype=np.float64)   # TRUE time measure
            col = palette(tmid)
            inwin = (tmid >= T0) & (tmid < T0 + DT)
            wing_blaze_area += a[inwin].sum()
            wing_area_splat += a.sum()
            nsplat += len(a)
            x0 = np.floor(cx).astype(np.int64); y0 = np.floor(cy).astype(np.int64)
            fx = cx - x0; fy = cy - y0
            for dx, wx in ((0, 1 - fx), (1, fx)):
                for dy, wy in ((0, 1 - fy), (1, fy)):
                    xi = np.clip(x0 + dx, 0, S - 1); yi = np.clip(y0 + dy, 0, S - 1)
                    ww = (w * wx * wy).astype(np.float32)
                    flat = yi * S + xi
                    for ch in range(3):
                        np.add.at(bufflat[ch], flat, ww * col[:, ch].astype(np.float32))
                    np.add.at(tflat, flat, ww)
                    if inwin.any():
                        np.add.at(blaze, flat[inwin], ww[inwin])
            keep = ~done
            E, F, C, tlo = E[keep], F[keep], C[keep], tlo[keep]
        if level % 6 == 0:
            print(f"  wing p={p} level {level}: frontier {len(E):,} splatted {nsplat:,} "
                  f"{time.time()-t_start:.0f}s", flush=True)
    # estate share of the lit window
    share = wing_blaze_area / wing_area_splat
    report[f"share_p{p}"] = share
    print(f"[cascade] wing p={p}: {nsplat:,} leaves, estate share of {DT:.3f} window = "
          f"{share:.5f} (balanced would be {DT:.5f})", flush=True)
    if p == 0.5:
        assert abs(share - DT) / DT < 1e-3

blaze = blaze.reshape(S, S)

# ---------- compose: per-wing luminance normalization (mirrored worlds)
ys = np.arange(S, dtype=np.float32)[:, None]
xs = np.arange(S, dtype=np.float32)[None, :]
upper = ys < xs   # wing2 (cascade) is BELOW the main diagonal? apex top-right => region x>y
# wing1 apex bottom-left => region y>x ; wing2 apex top-right => region x>y
img = np.zeros((S, S, 3), dtype=np.float32)
dsafe = np.maximum(tdens, 1e-12)
for mask, kexp in ((~upper, 2.2), (upper, 2.2)):
    m = mask & (tdens > 0)
    if m.sum() == 0: continue
    ld = np.log(np.maximum(tdens, 1e-20))
    vals = np.sort(ld[m])
    # histogram-equalised log-density (ECDF), craft-note blend with linear
    he = np.searchsorted(vals, ld).astype(np.float32) / max(len(vals) - 1, 1)
    spread = float(vals[int(0.98 * len(vals))] - vals[int(0.02 * len(vals))])
    whe = min(0.72, max(0.15, spread / 8.0))   # adaptive: flat wing stays linear
    lin = 1 - np.exp(-kexp * tdens / max(np.percentile(tdens[m], 85), 1e-12))
    mix = whe * he + (1 - whe) * lin
    tone = (0.04 + 1.18 * np.power(np.clip(mix, 0, 1), 3.0)).astype(np.float32)
    print(f"[tone] wing spread={spread:.2f} whe={whe:.2f}")
    for ch in range(3):
        img[..., ch] = np.where(mask, (buf[ch] / dsafe) * tone, img[..., ch])

# ---------- multi-scale density AO (honest: eps-neighborhood density)
dn = np.clip(tdens / np.percentile(tdens[tdens > 0], 60), 0, 1.4)
ao = np.ones((S, S), dtype=np.float32)
for sg in (3, 12, 48):
    sig = sg * SS / 2
    ds = max(1, int(sig / 6))
    b = ndi.zoom(ndi.gaussian_filter(dn[::ds, ::ds], sig / ds), ds, order=1)[:S, :S]
    if b.shape != (S, S):
        b = np.pad(b, ((0, S - b.shape[0]), (0, S - b.shape[1])), mode="edge")
    ao *= (0.70 + 0.30 * np.clip(b, 0, 1))
img *= ao[..., None]

# ---------- gold blaze of the lit window (both wings, same threshold)
bl = blaze / max(np.percentile(blaze[blaze > 0], 90), 1e-12)
w = (1 - np.exp(-1.6 * np.power(np.clip(bl, 0, None), 0.6)))[..., None] * 0.9
gold = np.array([1.18, 0.92, 0.40], np.float32)
img = img * (1 - w) + gold[None, None, :] * w * (0.35 + 0.65 * np.clip(bl, 0, 1.6))[..., None]

# bloom on the blaze only (true foci)
hot = np.clip(img.sum(2) - 1.9, 0, None)
ds = 4
bloom = ndi.zoom(ndi.gaussian_filter(hot[::ds, ::ds], 10 * rs), ds, order=1)[:S, :S]
if bloom.shape != (S, S):
    bloom = np.pad(bloom, ((0, S - bloom.shape[0]), (0, S - bloom.shape[1])), mode="edge")
img += bloom[..., None] * np.array([1.0, 0.85, 0.5])[None, None, :] * 0.30

# diagonal seam: the shared law (total estate 2/3 A0 on each side) — thin cool line
dseam = np.abs(xs - ys)
img += np.exp(-(dseam / (1.1 * SS)) ** 2)[..., None] * np.array([0.10, 0.16, 0.20])[None, None, :]

img = np.clip(img, 0, None)
img = img / (1 + 0.16 * img)              # soft knee, never clip to white
img = np.power(np.clip(img, 0, 1), 1 / 2.2)
img = (img + np.random.uniform(-1/255, 1/255, img.shape)).clip(0, 1)

im = Image.fromarray((img * 255).astype(np.uint8))
im = im.resize((SIZE, SIZE), Image.LANCZOS)
im.save(OUT)
print(f"[cascade] wrote {OUT} in {time.time()-t_start:.0f}s")
print("[cascade] report:", report)
